# MQTT 探测脚本用的环境变量（scripts/*.mjs 从 process.env 读取，不写入文件）
#
# 注意：前端必须使用【控制端账号】，禁止使用设备账号（esp32_pc01）——
# 设备账号在 broker 上只有 Publish 权限，订阅会被 ACL 拒绝。
MQTT_USER=your_controller_username
MQTT_PASS=your_controller_password

# broker 连接参数（WebSocket 端口，不是设备用的 8883）
MQTT_HOST=e188cf19.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8084
MQTT_PATH=/mqtt

# Client ID：broker ACL 按 client id 匹配，必须是控制端 id，否则订阅/发布会被拒
MQTT_CLIENT_ID=pc01-controller

# 设备 ID，须与固件 NVS 里的 dev_id 一致（默认 pc01）
MQTT_DEVICE_ID=pc01
